{
  "name": "instagram-webhook-bot",
  "version": "1.0.0",
  "description": "Instagram Webhook Bot with HTTPS tunnel",
  "scripts": {
    "tunnel": "lt --port 5001 --print-requests",
    "start": "python instagram_webhook_bot.py",
    "dev": "npm-run-all --parallel start tunnel"
  },
  "keywords": [
    "instagram",
    "webhook",
    "bot",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "localtunnel": "^2.0.2",
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.0"
  }
}
